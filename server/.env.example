PIANOVAL_DEVICE=cpu
PIANOVAL_THRESHOLD=0.74
PIANOVAL_MEL_OFFSET_DB=-22
PIANOVAL_LEFT_FRAMES=100
PIANOVAL_STEP_FRAMES=8
PIANOVAL_RIGHT_FRAMES=12
PIANOVAL_MAX_SESSIONS=2
PIANOVAL_MAX_AUDIO_SECONDS=600
# Set these for the intended deployment. Empty token is for local development.
PIANOVAL_TOKEN=
PIANOVAL_ALLOWED_ORIGINS=

# Optional browser login. Generate a password hash locally; no default account.
# PIANOVAL_LOGIN_USERNAME=your-own-username
# PIANOVAL_PASSWORD_HASH=your-generated-password-hash
# PIANOVAL_LOGIN_ACCOUNTS_JSON={}
